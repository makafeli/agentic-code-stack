{
  "model": "opus[1m]",
  "cleanupPeriodDays": 99999,
  "editorMode": "normal",
  "autoCompactEnabled": true,
  "agentPushNotifEnabled": true,

  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "24.4",
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "1000000"
  },

  "permissions": {
    "defaultMode": "auto",
    "allow": [
      "Bash(python3 *)",
      "Bash(npm list *)",
      "Bash(npm view *)",
      "Bash(claude plugin *)",
      "Bash(npx skills *)",
      "Bash(ps *)",
      "WebFetch(domain:raw.githubusercontent.com)",
      "mcp__bright-data__scrape_as_markdown",
      "mcp__bright-data__scrape_batch"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Grep|Glob",
        "hooks": [
          { "type": "command", "command": "~/.claude/hooks/cbm-code-discovery-gate", "timeout": 5 }
        ]
      }
    ],
    "SessionStart": [
      { "matcher": "startup", "hooks": [{ "type": "command", "command": "~/.claude/hooks/cbm-session-reminder" }] },
      { "matcher": "resume",  "hooks": [{ "type": "command", "command": "~/.claude/hooks/cbm-session-reminder" }] },
      { "matcher": "clear",   "hooks": [{ "type": "command", "command": "~/.claude/hooks/cbm-session-reminder" }] },
      { "matcher": "compact", "hooks": [{ "type": "command", "command": "~/.claude/hooks/cbm-session-reminder" }] }
    ]
  },

  "extraKnownMarketplaces": {
    "claude-plugins-official": { "source": { "source": "github", "repo": "anthropics/claude-plugins-official" } },
    "ponytail": { "source": { "source": "github", "repo": "DietrichGebert/ponytail" } },
    "expo-plugins": { "source": { "source": "github", "repo": "expo/skills" } },
    "swiftui-agent-skill": { "source": { "source": "git", "url": "https://github.com/twostraws/SwiftUI-Agent-Skill.git" } },
    "conorluddy": { "source": { "source": "github", "repo": "conorluddy/ios-simulator-skill" } },
    "fastlane-skill": { "source": { "source": "github", "repo": "greenstevester/fastlane-skill" } },
    "ui-ux-pro-max-skill": { "source": { "source": "github", "repo": "nextlevelbuilder/ui-ux-pro-max-skill" } },
    "claude-for-financial-services": { "source": { "source": "github", "repo": "anthropics/financial-services" } }
  },

  "enabledPlugins": {
    "code-review@claude-plugins-official": true,
    "security-guidance@claude-plugins-official": true,
    "frontend-design@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "claude-code-setup@claude-plugins-official": true,
    "claude-md-management@claude-plugins-official": true,
    "github@claude-plugins-official": true,
    "chrome-devtools-mcp@claude-plugins-official": true,
    "railway@claude-plugins-official": true,
    "sentry@claude-plugins-official": true,
    "ponytail@ponytail": true,
    "expo@expo-plugins": true,
    "swiftui-pro@swiftui-agent-skill": true,
    "ios-simulator-skill@conorluddy": true,
    "ui-ux-pro-max@ui-ux-pro-max-skill": true,
    "market-researcher@claude-for-financial-services": true,
    "beta@fastlane-skill": true,
    "match@fastlane-skill": true,
    "release@fastlane-skill": true,
    "setup-fastlane@fastlane-skill": true,
    "snapshot@fastlane-skill": true
  }
}
